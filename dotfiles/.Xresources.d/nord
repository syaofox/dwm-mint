dwm.col_selocc_bg:      BG
dwm.col_selocc_border:  TAG_UL

! dwm 状态栏颜色（dwmbar）
dwm.col_status_fg:      STATUS_FG
dwm.col_status_bg:      BG
dwm.col_status_border:  BG

! dwm 窗口标题区颜色（标题栏）
