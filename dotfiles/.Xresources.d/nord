! dwm 窗口颜色 - 未选中，无客户端（窗口）状态
dwm.col_norm_fg:        BLACK
dwm.col_norm_bg:        BG
dwm.col_norm_border:    BLACK

! dwm 窗口颜色 - 选中，无客户端（窗口）状态
dwm.col_sel_fg:         SEL_FG
dwm.col_sel_bg:         SEL_BG
dwm.col_sel_border:     TAG_UL

! dwm 窗口颜色 - 未选中，有客户端（窗口在窗口区显示）
dwm.col_occ_fg:         SEL_FG
dwm.col_occ_bg:         BG
dwm.col_occ_border:     BLACK

! dwm 窗口颜色 - 选中，有客户端（窗口区有窗口且当前激活）
