! dwm 窗口颜色 - 选中，无客户端
dwm.col_sel_fg:         SEL_FG
dwm.col_sel_bg:         SEL_BG
dwm.col_sel_border:     SEL_FG

! dwm 窗口颜色 - 未选中，有客户端
