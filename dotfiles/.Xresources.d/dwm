! dwm 窗口颜色 - 未选中，无客户端
dwm.col_norm_fg:        FG_DIM
dwm.col_norm_bg:        BG
dwm.col_norm_border:    BORDER

! dwm 窗口颜色 - 选中，无客户端
dwm.col_sel_fg:         SEL_FG
dwm.col_sel_bg:         SEL_BG
dwm.col_sel_border:     SEL_BORDER

! dwm 窗口颜色 - 未选中，有客户端
dwm.col_occ_fg:         FG
dwm.col_occ_bg:         BG
dwm.col_occ_border:     BORDER

! dwm 窗口颜色 - 选中，有客户端
dwm.col_selocc_fg:      TITLE_FG
dwm.col_selocc_bg:      SEL_BG
dwm.col_selocc_border:  SEL_BORDER

! dwm 状态栏颜色（dwmbar）
dwm.col_status_fg:      STATUS_FG
dwm.col_status_bg:      BG
dwm.col_status_border:  BG

! dwm 窗口标题区颜色（标题栏）
dwm.col_title_fg:       FG
dwm.col_title_bg:       BG
dwm.col_title_border:   BORDER

! dwm 窗口标题区颜色 - 选中状态
dwm.col_titlesel_fg:    TITLE_FG
dwm.col_titlesel_bg:    SEL_BG
dwm.col_titlesel_border: BORDER

! dwm Tag 标签下划线颜色
dwm.col_tagunderline:   TAG_UL
dwm.tagunderline: 0

! slstatus 状态栏颜色
slstatus.sep:   SLSEP
slstatus.net:   SLNET
slstatus.cpu:   SLCPU
slstatus.ram:   SLRAM
slstatus.gpu:   SLGPU
slstatus.kbd:   RED
