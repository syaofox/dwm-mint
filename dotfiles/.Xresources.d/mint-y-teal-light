! Mint-Y-Teal Light Theme Colors for dwm


#define BLACK           #808080
#define RED             #E74C3C
#define GREEN           #27AE60
#define YELLOW          #D4A017
#define BLUE            #1A8693
#define MAGENTA         #2bdff3
#define CYAN            #1A8693
#define WHITE           #FFFFFF

#define BG              #EAF2F1
#define FG              #2D3436
#define BG_ALT          #3D5A5E
#define SEL_BG          #1A8693
#define SEL_FG          #FFFFFF

#define LOCK_TEXT       #27c6d8
#define PS1_BRANCH      #868686
#define GTK_THEME       Mint-Y-Teal
#define GTK_FONT        Noto Sans 10
#define DARK_THEME      0
#define YAZI_DARK       flexoki-light
#define ROFI_SEL_FG     #FFFFFF

! dwm 窗口颜色 - 未选中，无客户端
dwm.col_norm_fg:        BLACK
dwm.col_norm_bg:        BG
dwm.col_norm_border:    BG_ALT

! dwm 窗口颜色 - 选中，无客户端
dwm.col_sel_fg:         SEL_FG
dwm.col_sel_bg:         SEL_BG
dwm.col_sel_border:     MAGENTA

! dwm 窗口颜色 - 未选中，有客户端
dwm.col_occ_fg:         FG
dwm.col_occ_bg:         BG
dwm.col_occ_border:     BG_ALT

! dwm 窗口颜色 - 选中，有客户端
dwm.col_selocc_fg:      SEL_FG
dwm.col_selocc_bg:      SEL_BG
dwm.col_selocc_border:  MAGENTA

! dwm 状态栏颜色（dwmbar）
dwm.col_status_fg:      FG
dwm.col_status_bg:      BG
dwm.col_status_border:  BG

! dwm 窗口标题区颜色（标题栏）
dwm.col_title_fg:       FG
dwm.col_title_bg:       BG
dwm.col_title_border:   BG_ALT

! dwm 窗口标题区颜色 - 选中状态
dwm.col_titlesel_fg:    SEL_FG
dwm.col_titlesel_bg:    SEL_BG
dwm.col_titlesel_border: BG

! dwm Tag 标签下划线颜色
dwm.col_tagunderline:   BLUE
dwm.tagunderline: 0

! slstatus 状态栏颜色
slstatus.sep:   BG_ALT
slstatus.net:   BLUE
slstatus.cpu:   YELLOW
slstatus.ram:   YELLOW
slstatus.gpu:   GREEN
slstatus.temp:  WHITE
slstatus.kbd:   RED
slstatus.swap:  WHITE
slstatus.time:  FG

! slock 锁屏颜色
slock.init:     BG
slock.input:    BLUE
slock.fail:     RED
slock.text:     LOCK_TEXT
