#!/bin/bash

# Show a fuzzy-finder TUI for picking new Flatpak packages to install.

fzf_args=(
  --multi
  --preview 'flatpak remote-info flathub {1} 2>/dev/null || flatpak info {1} 2>/dev/null'
  --preview-label='alt-p: toggle description, alt-j/k: scroll, tab: multi-select'
  --preview-label-pos='bottom'
  --preview-window 'down:65%:wrap'
  --bind 'alt-p:toggle-preview'
  --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up'
  --bind 'alt-k:preview-up,alt-j:preview-down'
  --color 'pointer:green,marker:green'
)

pkg_names=$(flatpak remote-ls --app --columns=application 2>/dev/null | fzf "${fzf_args[@]}")

if [[ -n $pkg_names ]]; then
  # Display the list of packages to be installed
  echo "Packages to install:"
  i=1
  while IFS= read -r pkg; do
    printf "%2d. \033[1;32m%s\033[0m\n" $((i++)) "$pkg"
  done <<< "$pkg_names"
  echo
  read -p "Do you want to proceed with the installation? [y/N] " -n 1 -r
  echo
  if [[ $REPLY =~ ^[Yy]$ ]]; then
    # Convert newline-separated selections to space-separated for flatpak
    while IFS= read -r pkg; do
      flatpak install -y flathub "$pkg"
    done <<< "$pkg_names"
  else
    echo "Installation cancelled."
  fi
fi
