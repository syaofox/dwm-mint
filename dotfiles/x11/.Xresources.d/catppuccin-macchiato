dunst.urgency_normal_fg:       #cad3f5
dunst.urgency_normal_frame:    #8aadf4
dunst.urgency_critical_bg:     #c6a0f6
dunst.urgency_critical_fg:     #ed8796
dunst.urgency_critical_frame:  #f0c6c6

! rofi 启动器颜色
rofi.icontheme:                Mint-Y-Pink
rofi.background:               #24273a
rofi.foreground:               #cad3f5
rofi.selected_bg:              #8aadf4
rofi.selected_fg:              #24273a
rofi.active_fg:                #8aadf4

! wezterm 终端颜色
wezterm.bg:                    #24273a
wezterm.fg:                    #cad3f5
wezterm.cursor_bg:             #cad3f5
wezterm.black:                 #494d64
