! Mint-Y-Teal Theme Colors for dwm
!
! Color Palette Reference:
!   #162124  bg_dark   - Background dark
!   #5D6D72  bg_light  - Background light
!   #1A8693  teal      - Teal
!   #25bdce  teal_light- Teal light
!   #E7B448  yellow    - Yellow
!   #2ECC71  green     - Green
!   #E74C3C  red       - Red
!   #FFFFFF  white     - White
!   #E4E4E4  gray      - Gray

! dwm 窗口颜色 - 未选中，无客户端（窗口）状态
dwm.col_norm_fg:        #5D6D72
dwm.col_norm_bg:        #162124
dwm.col_norm_border:    #5D6D72


! dwm 窗口颜色 - 选中，无客户端（窗口）状态
dwm.col_sel_fg:         #FFFFFF
dwm.col_sel_bg:        #1A8693
dwm.col_sel_border:    #1A8693


! dwm 窗口颜色 - 未选中，有客户端（窗口在窗口区显示）
dwm.col_occ_fg:         #FFFFFF
dwm.col_occ_bg:        #162124
dwm.col_occ_border:    #5D6D72


! dwm 窗口颜色 - 选中，有客户端（窗口区有窗口且当前激活）
dwm.col_selocc_fg:      #FFFFFF
dwm.col_selocc_bg:     #1A8693
dwm.col_selocc_border: #1A8693


! dwm 状态栏颜色（dwmbar）
dwm.col_status_fg:      #E4E4E4
dwm.col_status_bg:      #162124
dwm.col_status_border:  #162124


! dwm 窗口标题区颜色（标题栏）
dwm.col_title_fg:       #FFFFFF
dwm.col_title_bg:       #162124
dwm.col_title_border:   #5D6D72


! dwm 窗口标题区颜色 - 选中状态
dwm.col_titlesel_fg:    #FFFFFF
dwm.col_titlesel_bg:    #1A8693
dwm.col_titlesel_border: #162124


! dwm Tag 标签下划线颜色
dwm.col_tagunderline:   #1A8693
dwm.tagunderline: 0


! slstatus 状态栏颜色（系统信息显示）
slstatus.sep:   #5D6D72
slstatus.net:   #1A8693
slstatus.cpu:   #E7B448
slstatus.ram:   #E7B448
slstatus.gpu:   #2ECC71
slstatus.time:  #FFFFFF


! slock 锁屏颜色
slock.init:     #162124
slock.input:    #25bdce
slock.fail:     #E74C3C
slock.text:     #1A8693


! PS1 bash 提示符颜色
ps1.dir:    #d8f4f7
ps1.prompt: #25bdce
ps1.branch: #868686

! dunst 通知颜色
dunst.urgency_low_bg:          #162124
dunst.urgency_low_fg:          #E4E4E4
dunst.urgency_low_frame:       #1A8693
dunst.urgency_normal_bg:       #5D6D72
dunst.urgency_normal_fg:       #E4E4E4
dunst.urgency_normal_frame:    #1A8693
dunst.urgency_critical_bg:     #E74C3C
dunst.urgency_critical_fg:     #FFFFFF
dunst.urgency_critical_frame:  #E74C3C

! rofi 启动器颜色
rofi.icontheme:                Mint-Y-Teal
rofi.background:               #162124
rofi.foreground:               #E4E4E4
rofi.selected_bg:              #1A8693
rofi.selected_fg:              #FFFFFF
rofi.active_fg:                #1A8693

! wezterm 终端颜色
wezterm.bg:                    #162124
wezterm.fg:                    #E4E4E4
wezterm.cursor_bg:             #E4E4E4
wezterm.black:                 #5D6D72
wezterm.red:                   #E74C3C
wezterm.green:                 #2ECC71
wezterm.yellow:                #E7B448
wezterm.blue:                  #25bdce
wezterm.magenta:               #1A8693
wezterm.cyan:                  #25bdce
wezterm.white:                 #FFFFFF

! yazi 文件管理器主题
yazi.dark:                     flexoki-dark
yazi.light:                    flexoki-light

! GTK 主题设置
gtk.theme:                     Mint-Y-Teal
gtk.icon_theme:                Mint-Y-Teal
gtk.font:                      Noto Sans 10
gtk.gtk-application-prefer-dark-theme: 0

