! Gruvbox Theme Colors for dwm
!
! Color Palette Reference:
!   #282828  bg0_hard   - Background dark
!   #3c3836  bg1        - Background
!   #ebdbb2  fg         - Foreground
!   #d5c4a1  fg_dim     - Foreground dim
!   #fb4934  red        - Red
!   #b8bb26  green      - Green
!   #fabd2f  yellow     - Yellow
!   #83a598  aqua       - Aqua/Teal
!   #d3869b  purple     - Purple

! dwm 窗口颜色 - 未选中，无客户端
dwm.col_norm_fg:        #ebdbb2
dwm.col_norm_bg:        #282828
dwm.col_norm_border:   #3c3836


! dwm 窗口颜色 - 选中，无客户端
dwm.col_sel_fg:      #282828
dwm.col_sel_bg:       #fabd2f
dwm.col_sel_border:   #fabd2f


! dwm 窗口颜色 - 未选中，有客户端
dwm.col_occ_fg:      #ebdbb2
dwm.col_occ_bg:      #282828
dwm.col_occ_border:  #3c3836


! dwm 窗口颜色 - 选中，有客户端
dwm.col_selocc_fg:    #282828
dwm.col_selocc_bg:    #fabd2f
dwm.col_selocc_border: #fabd2f


! dwm 状态栏颜色（dwmbar）
dwm.col_status_fg:    #ebdbb2
dwm.col_status_bg:    #282828
dwm.col_status_border: #282828


! dwm 窗口标题区颜色（标题栏）
dwm.col_title_fg:     #ebdbb2
dwm.col_title_bg:     #282828
dwm.col_title_border: #3c3836

dwm.col_titlesel_fg:   #282828
dwm.col_titlesel_bg:   #fabd2f
