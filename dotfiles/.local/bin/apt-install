#!/bin/bash

# Show a fuzzy-finder TUI for picking new Debian/Ubuntu packages to install.

fzf_args=(
  --multi
  --preview 'apt show {1} 2>/dev/null'
  --preview-label='alt-p: toggle description, alt-j/k: scroll, tab: multi-select'
  --preview-label-pos='bottom'
  --preview-window 'down:65%:wrap'
  --bind 'alt-p:toggle-preview'
  --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up'
  --bind 'alt-k:preview-up,alt-j:preview-down'
  --color 'pointer:green,marker:green'
)

pkg_names=$(apt-cache pkgnames | fzf "${fzf_args[@]}")

if [[ -n $pkg_names ]]; then
  # 打印选中的包名列表
  echo -e "\n\033[1;34m准备安装以下软件包:\033[0m"
  echo "-----------------------------------"
  i=1
  # 使用 mapfile 将换行符分隔的字符串转换为数组
  mapfile -t pkgs_array <<< "$pkg_names"
  
  for pkg in "${pkgs_array[@]}"; do
    printf "%2d. \033[1;32m%s\033[0m\n" $((i++)) "$pkg"
  done
  echo "-----------------------------------"
  
  # 确认提示
  read -p "是否继续安装？ [Y/n] " -n 1 -r
  echo
  
  if [[ ! $REPLY =~ ^[Nn]$ ]]; then
    echo -e "\n\033[1;33m正在安装软件包，请稍候...\033[0m\n"
    
    sudo apt install -y "${pkgs_array[@]}"
    
    # 检查退出码
    if [ $? -eq 0 ]; then
      echo -e "\n\033[1;32m✔ 所有软件包已成功安装！\033[0m"
    else
      echo -e "\n\033[1;31m✘ 安装过程中出现错误。\033[0m"
    fi
  else
    echo "操作已取消。"
  fi
fi
